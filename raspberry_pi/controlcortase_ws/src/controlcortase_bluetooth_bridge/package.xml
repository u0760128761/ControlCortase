<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controlcortase_bluetooth_bridge</name>
  <version>1.0.0</version>
  <description>ROS2 Bluetooth RFCOMM bridge for ControlCortase robot.
    Accepts legacy ASCII protocol over Bluetooth SPP and publishes
    geometry_msgs/Twist on /cmd_vel. Supports reconnection and watchdog.</description>

  <maintainer email="admin@controlcortase.local">ControlCortase Project</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
